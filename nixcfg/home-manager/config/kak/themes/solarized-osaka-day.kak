# ======================== SOLARIZED OSAKA DAY ========================

# UI
face global Default            rgb:586e74,rgb:fdf5e0
face global PrimarySelection   rgb:fdf5e0,rgb:268bd2
face global SecondarySelection rgb:fdf5e0,rgb:93a1a1
face global PrimaryCursor      rgb:fdf5e0,rgb:586e74
face global SecondaryCursor    rgb:fdf5e0,rgb:93a1a1
face global PrimaryCursorEol   rgb:fdf5e0,rgb:586e74
face global SecondaryCursorEol rgb:fdf5e0,rgb:93a1a1

face global LineNumbers        rgb:93a1a1
face global LineNumberCursor   rgb:586e74
face global LineNumbersWrapped rgb:93a1a1

face global MenuForeground     rgb:fdf5e0,rgb:268bd2
face global MenuBackground     rgb:586e74,rgb:fdf6e3
face global MenuInfo           rgb:b58900

face global Information        rgb:b58900
face global Error              rgb:dc322f
face global StatusLine         rgb:586e74,rgb:fdf6e3
face global StatusLineMode     rgb:b58900
face global StatusLineInfo     rgb:268bd2
face global StatusLineValue    rgb:859900

face global Prompt             rgb:b58900
face global MatchingChar       rgb:b58900,rgb:fdf6e3
face global BufferPadding      rgb:93a1a1

# Syntax
face global keyword            rgb:b58900
face global attribute          rgb:268bd2
face global type               rgb:268bd2
face global string             rgb:859900
face global comment            rgb:93a1a1
face global function           rgb:586e74
face global variable           rgb:586e74
face global constant           rgb:b58900
face global operator           rgb:586e74
face global meta               rgb:6c71c4

# Extras
face global title              rgb:b58900
face global header             rgb:268bd2
face global bold               rgb:586e74+b
face global italic             rgb:586e74+i
face global mono               rgb:859900
face global block              rgb:6c71c4
face global link               rgb:268bd2+u
face global bullet             rgb:b58900
face global list               rgb:586e74
