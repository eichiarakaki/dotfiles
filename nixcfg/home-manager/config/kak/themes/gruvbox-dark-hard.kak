# ======================== GRUVBOX DARK HARD ========================

# Palette
# bg0_hard = #1d2021
# bg0      = #282828
# bg1      = #3c3836
# bg2      = #504945
# bg3      = #665c54
# bg4      = #7c6f64
# fg0      = #fbf1c7
# fg1      = #ebdbb2
# fg2      = #d5c4a1
# fg3      = #bdae93
# fg4      = #a89984

# red      = #fb4934
# green    = #b8bb26
# yellow   = #fabd2f
# blue     = #83a598
# purple   = #d3869b
# aqua     = #8ec07c
# orange   = #fe8019

# dark red    = #cc241d
# dark green  = #98971a
# dark yellow = #d79921
# dark blue   = #458588
# dark purple = #b16286
# dark aqua   = #689d6a
# dark orange = #d65d0e


# UI
face global Default            rgb:ebdbb2,rgb:1d2021
face global PrimarySelection   rgb:1d2021,rgb:fabd2f
face global SecondarySelection rgb:ebdbb2,rgb:504945

face global PrimaryCursor      rgb:1d2021,rgb:ebdbb2
face global SecondaryCursor    rgb:1d2021,rgb:a89984
face global PrimaryCursorEol   rgb:1d2021,rgb:ebdbb2
face global SecondaryCursorEol rgb:1d2021,rgb:a89984

face global LineNumbers        rgb:7c6f64
face global LineNumberCursor   rgb:fabd2f
face global LineNumbersWrapped rgb:665c54

face global MenuForeground     rgb:1d2021,rgb:fabd2f
face global MenuBackground     rgb:ebdbb2,rgb:282828
face global MenuInfo           rgb:fe8019

face global Information        rgb:fabd2f
face global Error              rgb:fb4934

face global StatusLine         rgb:ebdbb2,rgb:282828
face global StatusLineMode     rgb:fe8019,rgb:282828
face global StatusLineInfo     rgb:83a598,rgb:282828
face global StatusLineValue    rgb:b8bb26,rgb:282828

face global Prompt             rgb:fabd2f
face global MatchingChar       rgb:fabd2f,rgb:3c3836
face global BufferPadding      rgb:282828


# Syntax
face global keyword            rgb:fb4934
face global attribute          rgb:fabd2f
face global type               rgb:fabd2f
face global string             rgb:b8bb26
face global comment            rgb:928374+i
face global function           rgb:83a598
face global variable           rgb:ebdbb2
face global constant           rgb:d3869b
face global operator           rgb:fe8019
face global meta               rgb:8ec07c


# Extras
face global title              rgb:fabd2f
face global header             rgb:83a598
face global bold               rgb:ebdbb2+b
face global italic             rgb:ebdbb2+i
face global mono               rgb:b8bb26
face global block              rgb:504945
face global link               rgb:83a598+u
face global bullet             rgb:fe8019
face global list               rgb:ebdbb2
