# ======================== SOLARIZED OSAKA DARK ========================

# Palette
# background = #001a1d
# foreground = #839496
# black      = #073642
# red        = #dc322f
# green      = #859900
# yellow     = #b58900
# blue       = #268bd2
# magenta    = #d33682
# cyan       = #2aa198
# white      = #eee8d5

# Bright
# br_black   = #4c4c4c
# br_red     = #cb4b16
# br_green   = #586e75
# br_yellow  = #657b83
# br_blue    = #839496
# br_magenta = #6c71c4
# br_cyan    = #93a1a1
# br_white   = #fdf6e3


# UI
face global Default            rgb:839496,rgb:001a1d
face global PrimarySelection   rgb:fdf6e3,rgb:268bd2
face global SecondarySelection rgb:eee8d5,rgb:073642

face global PrimaryCursor      rgb:001a1d,rgb:839496
face global SecondaryCursor    rgb:001a1d,rgb:586e75
face global PrimaryCursorEol   rgb:001a1d,rgb:839496
face global SecondaryCursorEol rgb:001a1d,rgb:586e75

face global LineNumbers        rgb:586e75
face global LineNumberCursor   rgb:93a1a1
face global LineNumbersWrapped rgb:4c4c4c

face global MenuForeground     rgb:fdf6e3,rgb:268bd2
face global MenuBackground     rgb:839496,rgb:073642
face global MenuInfo           rgb:b58900

face global Information        rgb:b58900
face global Error              rgb:dc322f

face global StatusLine         rgb:839496,rgb:073642
face global StatusLineMode     rgb:b58900,rgb:073642
face global StatusLineInfo     rgb:268bd2,rgb:073642
face global StatusLineValue    rgb:859900,rgb:073642

face global Prompt             rgb:b58900
face global MatchingChar       rgb:b58900,rgb:073642
face global BufferPadding      rgb:073642


# Syntax
face global keyword            rgb:b58900
face global attribute          rgb:268bd2
face global type               rgb:268bd2
face global string             rgb:859900
face global comment            rgb:586e75+i
face global function           rgb:839496
face global variable           rgb:839496
face global constant           rgb:cb4b16
face global operator           rgb:93a1a1
face global meta               rgb:6c71c4


# Extras
face global title              rgb:b58900
face global header             rgb:268bd2
face global bold               rgb:839496+b
face global italic             rgb:839496+i
face global mono               rgb:859900
face global block              rgb:6c71c4
face global link               rgb:268bd2+u
face global bullet             rgb:b58900
face global list               rgb:839496
