# ======================== BASE16 DEFAULT DARK ========================

# UI
face global Default            rgb:d8d8d8,rgb:181818
face global PrimarySelection   rgb:181818,rgb:7cafc2
face global SecondarySelection rgb:181818,rgb:585858
face global PrimaryCursor      rgb:181818,rgb:d8d8d8
face global SecondaryCursor    rgb:181818,rgb:585858
face global PrimaryCursorEol   rgb:181818,rgb:d8d8d8
face global SecondaryCursorEol rgb:181818,rgb:585858

face global LineNumbers        rgb:585858
face global LineNumberCursor   rgb:d8d8d8
face global LineNumbersWrapped rgb:585858

face global MenuForeground     rgb:181818,rgb:7cafc2
face global MenuBackground     rgb:d8d8d8,rgb:181818
face global MenuInfo           rgb:f7ca88

face global Information        rgb:f7ca88
face global Error              rgb:ab4642
face global StatusLine         rgb:d8d8d8,rgb:181818
face global StatusLineMode     rgb:f7ca88
face global StatusLineInfo     rgb:7cafc2
face global StatusLineValue    rgb:a1b56c

face global Prompt             rgb:f7ca88
face global MatchingChar       rgb:f7ca88,rgb:181818
face global BufferPadding      rgb:585858

# Syntax
face global keyword            rgb:f7ca88
face global attribute          rgb:7cafc2
face global type               rgb:7cafc2
face global string             rgb:a1b56c
face global comment            rgb:585858
face global function           rgb:d8d8d8
face global variable           rgb:d8d8d8
face global constant           rgb:f7ca88
face global operator           rgb:d8d8d8
face global meta               rgb:ba8baf

# Extras
face global title              rgb:f7ca88
face global header             rgb:7cafc2
face global bold               rgb:d8d8d8+b
face global italic             rgb:d8d8d8+i
face global mono               rgb:a1b56c
face global block              rgb:ba8baf
face global link               rgb:7cafc2+u
face global bullet             rgb:f7ca88
face global list               rgb:d8d8d8
